# Environment Variables Template
# Copy this to .env and fill in with your actual values

# ============ MongoDB ============
MONGODB_URL=mongodb+srv://pater_admin:PASSWORD@cluster0.xxxxx.mongodb.net/pater?retryWrites=true&w=majority

# ============ API Configuration ============
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True
ENVIRONMENT=development

# ============ ML Models ============
MODELS_PATH=./ml/models
ENABLE_ARIMA=True
ENABLE_LGBM=True
ENABLE_GNN=False

# ============ Scraping ============
SCRAPER_TIMEOUT=30
SCRAPER_RETRY_COUNT=3
SCRAPER_RATE_LIMIT=2  # seconds between requests

# ============ Redis (Caching) ============
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600  # seconds

# ============ Neo4j (Graph Database) ============
NEO4J_URL=neo4j+s://username:password@instance.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ============ Feature Flags ============
ENABLE_PREDICTIONS=True
ENABLE_WEBSOCKET=False
ENABLE_AFFILIATE=False

# ============ Rate Limiting ============
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# ============ Security ============
SECRET_KEY=your-secret-key-here-change-in-production
CORS_ORIGINS=*
ALLOWED_HOSTS=*

# ============ Logging ============
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============ Notification ============
ENABLE_NOTIFICATIONS=True
NOTIFICATION_EMAIL=your-email@example.com

# ============ Analytics ============
ANALYTICS_ENABLED=True
ANALYTICS_API_KEY=your-analytics-key

# ============ Performance ============
WORKER_THREADS=4
MAX_CONNECTIONS=100
CONNECTION_TIMEOUT=10

# ============ File Storage ============
GCS_BUCKET=pater-models
GCS_PROJECT_ID=pater-ai
GCS_CREDENTIALS_PATH=./credentials.json
